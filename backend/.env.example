# Ejemplo para MySQL de Aiven. Nunca escribas aquí las credenciales reales.
DB_URL=jdbc:mysql://HOST_AIVEN:PUERTO_AIVEN/defaultdb?sslMode=REQUIRED&serverTimezone=America/Lima
DB_USERNAME=avnadmin
DB_PASSWORD=REEMPLAZAR_EN_RENDER
DB_DRIVER=com.mysql.cj.jdbc.Driver
DB_DIALECT=org.hibernate.dialect.MySQLDialect
DB_DDL_AUTO=update

# Genera un secreto largo y distinto para el despliegue real.
JWT_SECRET=REEMPLAZAR_POR_UN_SECRETO_DE_AL_MENOS_32_CARACTERES
JWT_EXPIRATION_SECONDS=28800

# Solo el origen, sin ruta final ni barra. Se pueden indicar varios separados por coma.
CORS_ALLOWED_ORIGINS=https://xkelvin0.github.io
PORT=8080
